# Raw and processed data (too large / not reproducible to commit)
data/raw/*
data/processed/*
data/training/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/training/.gitkeep

# Outputs (regenerate from code, don't commit)
results/figures/*
results/maps/*
results/predictions/*
results/evaluation/*
!results/**/.gitkeep

# Jupyter checkpoints
.ipynb_checkpoints/

# Python cache
__pycache__/
*.pyc

# OS/editor cruft
.DS_Store
